# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real file.
# The two passwords below must match the ones in the connection strings.

# Used by docker-compose.yml.
CONSOLE_HOST=app.zinloop.com
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME_TOO

# Postgres. The owner connection runs migrations and maintenance scripts; the
# console itself connects as zinloop_app, which row-level security restricts.
DATABASE_ADMIN_URL=postgres://zinloop_owner:CHANGE_ME@db:5432/zinloop
DATABASE_URL=postgres://zinloop_app:CHANGE_ME_TOO@db:5432/zinloop

# 32 random bytes for encrypting authenticator secrets and signing short-lived
# values: openssl rand -base64 32
APP_SECRET=

# Public address of the console, used in invite links and Microsoft's redirect.
CONSOLE_URL=https://app.zinloop.com

# Set to 1 when a reverse proxy (Caddy, nginx, a load balancer) sets X-Forwarded-For.
TRUST_PROXY=1

# Microsoft 365 checks (optional). See docs/m365.md.
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# "Sign in with Microsoft" uses the app above unless you set a separate one here.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Where /download sends laptops for scanner builds. Defaults to this repo's
# GitHub releases; set it if the repo is private or you host builds yourself.
DOWNLOAD_BASE_URL=

# Days to keep old scans (each laptop's newest is always kept).
SCAN_KEEP_DAYS=90

# Alert and weekly summary emails (optional). Any SMTP service works, e.g.
# Postmark, SendGrid, Amazon SES or Microsoft 365. Without these, emails wait
# in the database and nothing is sent. The from address's domain needs SPF and
# DKIM records from your mail service, or emails will land in spam.
SMTP_URL=
MAIL_FROM=Zinloop Security <alerts@zinloop.com>

# Backups: a dump every night in the "backups" volume, kept this many days.
BACKUP_KEEP_DAYS=14
# Off-site copies (strongly recommended). Any S3-compatible storage: Backblaze B2,
# Cloudflare R2, Wasabi, AWS S3. Copies are encrypted with this age public key;
# keep the private key somewhere safe and NOT on this server. See docs/deploy.md.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_AGE_RECIPIENT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Agent Control server (the upstream agent-control service in docker-compose.yml).
# It runs with its own Postgres (agent-control-db), separate from the tenant db.
# Password for that Postgres: openssl rand -base64 24
AGENT_CONTROL_POSTGRES_PASSWORD=CHANGE_ME
# Keep keys on. Agent keys your runtimes present; admin keys edit controls.
# openssl rand -hex 24 for each.
AGENT_CONTROL_API_KEY_ENABLED=true
AGENT_CONTROL_API_KEYS=CHANGE_ME_AGENT_KEY
AGENT_CONTROL_ADMIN_API_KEYS=CHANGE_ME_ADMIN_KEY
# Signs dashboard sessions: openssl rand -base64 32
AGENT_CONTROL_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
# The dashboard/API host port, and what address it binds to. Default 127.0.0.1
# keeps it reachable only on the server itself; set 0.0.0.0 (or front it with
# Caddy) to expose it, and then set CORS to the real origin.
AGENT_CONTROL_SERVER_HOST_PORT=8000
AGENT_CONTROL_BIND=127.0.0.1
AGENT_CONTROL_CORS_ORIGINS=http://localhost:8000
