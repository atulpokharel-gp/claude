# Copy to .env in this directory (deploy/agent-control/.env) and fill in.
# Never commit the real .env. These configure the upstream Agent Control server
# only; they are separate from the Zinloop stack's root .env.

# Host-side port mappings. The dashboard/UI and API are both served here.
AGENT_CONTROL_SERVER_HOST_PORT=8000
# 15432 by default so it won't fight another Postgres on the host.
AGENT_CONTROL_DB_HOST_PORT=15432

# Postgres password for the agent_control database (container-internal).
# openssl rand -base64 24
AGENT_CONTROL_POSTGRES_PASSWORD=CHANGE_ME

# API authentication. Keep this on. With it off the server trusts any caller.
AGENT_CONTROL_API_KEY_ENABLED=true
# Keys your agents present. Comma-separated. openssl rand -hex 24
AGENT_CONTROL_API_KEYS=CHANGE_ME_AGENT_KEY
# Admin keys for creating/editing controls via API. Keep these tighter.
AGENT_CONTROL_ADMIN_API_KEYS=CHANGE_ME_ADMIN_KEY
# Signs dashboard sessions. openssl rand -base64 32
AGENT_CONTROL_SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Browser origins allowed to call the server (the dashboard). Add your own host
# if you reverse-proxy the dashboard behind a domain.
AGENT_CONTROL_CORS_ORIGINS=http://localhost:8000
