{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "crons": [
    { "path": "/api/cron/mail", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/schedules", "schedule": "0 * * * *" },
    { "path": "/api/cron/daily?job=cleanup", "schedule": "0 3 * * *" },
    { "path": "/api/cron/daily?job=m365_sync", "schedule": "10 3 * * *" },
    { "path": "/api/cron/daily?job=snapshot", "schedule": "30 3 * * *" },
    { "path": "/api/cron/daily?job=mail_weekly", "schedule": "40 3 * * *" }
  ]
}
